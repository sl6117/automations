{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kf.entity_day.v1",
  "description": "One ticker on one UTC fetch day. Additional properties may appear in later v1 producers; consumers ignore them.",
  "type": "object",
  "required": ["schema_version", "ticker", "date", "posts", "posts_cashtag", "posts_own", "unique_voices", "posts_fetched", "share", "baseline", "z_share", "window_truncated", "window_partial", "available_at"],
  "properties": {
    "schema_version": {"const": "kf.entity_day.v1"},
    "ticker": {"type": "string", "pattern": "^[A-Z]{1,5}(\\.[A-Z])?$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "posts": {"type": "integer", "minimum": 1},
    "posts_cashtag": {"type": "integer", "minimum": 0},
    "posts_own": {"type": "integer", "minimum": 0},
    "unique_voices": {"type": "integer", "minimum": 1},
    "posts_fetched": {"type": "integer", "minimum": 1},
    "share": {"type": "number", "minimum": 0, "maximum": 1},
    "baseline": {
      "type": "object",
      "required": ["days", "mean_share", "std_share"],
      "properties": {
        "days": {"type": "integer", "minimum": 0, "maximum": 14},
        "mean_share": {"type": "number", "minimum": 0},
        "std_share": {"type": "number", "minimum": 0}
      }
    },
    "z_share": {"type": ["number", "null"]},
    "window_truncated": {"type": "boolean"},
    "window_partial": {"type": "boolean"},
    "available_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
