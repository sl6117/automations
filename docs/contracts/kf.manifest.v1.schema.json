{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kf.manifest.v1",
  "description": "Seal of one revision of one day. Additional properties may appear in later v1 producers; consumers ignore them.",
  "type": "object",
  "required": ["schema_version", "date", "revision", "sealed_at", "source_window", "files", "universe_version", "extractor_version", "posts_fetched", "window_truncated", "window_partial", "unmapped_cashtags", "supersedes"],
  "properties": {
    "schema_version": {"const": "kf.manifest.v1"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "revision": {"type": "integer", "minimum": 1},
    "sealed_at": {"$ref": "#/$defs/timestamp"},
    "source_window": {
      "type": "object",
      "required": ["first_fetch", "last_fetch"],
      "properties": {
        "first_fetch": {"$ref": "#/$defs/timestamp"},
        "last_fetch": {"$ref": "#/$defs/timestamp"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "records", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(mentions|entity_day)/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.r[0-9]+\\.jsonl$"},
          "records": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "universe_version": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "posts_fetched": {"type": "integer", "minimum": 0},
    "window_truncated": {"type": "boolean"},
    "window_partial": {"type": "boolean"},
    "unmapped_cashtags": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["symbol", "posts"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z]{1,5}(\\.[A-Z])?$"},
          "posts": {"type": "integer", "minimum": 1}
        }
      }
    },
    "supersedes": {"type": ["integer", "null"], "minimum": 1}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
